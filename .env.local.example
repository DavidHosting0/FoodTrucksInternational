# Demo-Modus: kein Login, lokale Seed-Daten (nur für Tests ohne DB)
NEXT_PUBLIC_DEMO_MODE=false

# Postgres auf deinem Server
DATABASE_URL=postgresql://user:password@localhost:5432/finance

# Auth.js – zufälligen Secret erzeugen: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: öffentlicher App-URL (für PWA / Produktion)
# AUTH_URL=https://finance.example.com

# Beleg-Uploads (relativ zum Projekt oder absolut)
UPLOAD_DIR=uploads
